#!/usr/bin/env bash
# Git credential helper that reads a GitHub token from this repo's git-ignored .env (key TOKEN_GIT).
# Enabled per repository only (devbox's init_hook does it; or run by hand):
#   git config --local credential.https://github.com.helper '!bash "$(git rev-parse --show-toplevel)/scripts/git-credential-env"'
# The token stays in .env. Nothing is written to .git/config or to a credential store.
# .env keys: TOKEN_GIT (required), GIT_USERNAME (optional, default: the user in the origin URL).
set -u
[ "${1:-}" = "get" ] || exit 0

host=""
while IFS='=' read -r key value; do
  [ -n "$key" ] || break
  [ "$key" = "host" ] && host="$value"
done
[ "$host" = "github.com" ] || exit 0

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
env_file="$root/.env"
[ -f "$env_file" ] || exit 0

# accepts KEY=value and KEY:value, CRLF line endings and quoted values
read_var() {
  tr -d '\r' < "$env_file" | sed -n "s/^$1[=:]//p" | head -1 | sed -e 's/^["'"'"']//' -e 's/["'"'"']$//'
}

token=$(read_var TOKEN_GIT)
[ -n "$token" ] || exit 0
user=$(read_var GIT_USERNAME)
if [ -z "$user" ]; then
  user=$(git config --get remote.origin.url | sed -n 's#^https://github.com/\([^/]*\)/.*#\1#p')
fi
echo "username=${user:-git}"
echo "password=$token"
