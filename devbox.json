{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/main/.schema/devbox.schema.json",
  "packages": [
    "jdk@21"
  ],
  "shell": {
    "init_hook": [
      "git config core.hooksPath .githooks || true",
      "git config --local credential.https://github.com.helper '!bash \"$(git rev-parse --show-toplevel)/scripts/git-credential-env\"' || true",
      "[ -f .env ] || echo 'Missing .env: copy .env.example to .env and put your SONAR_TOKEN in it.'"
    ],
    "scripts": {
      "build": "./mvnw -B verify",
      "test": "./mvnw -B test",
      "lint": "./mvnw -B checkstyle:check",
      "scan": "./scan.sh",
      "run": "bash -c \"set -a; . <(tr -d '\\r' < .env); set +a; DB_URL=jdbc:postgresql://localhost:\\${DB_PORT:-5433}/sonarcube ./mvnw -B spring-boot:run\"",
      "jenkins-up": "docker compose --env-file .env -f jenkins/docker-compose.yml up -d --build",
      "jenkins-logs": "docker compose --env-file .env -f jenkins/docker-compose.yml logs -f jenkins",
      "jenkins-down": "docker compose --env-file .env -f jenkins/docker-compose.yml down",
      "db-up": "docker compose --env-file .env up -d --wait db",
      "db-down": "docker compose --env-file .env down"
    }
  }
}
