{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/main/.schema/devbox.schema.json",
  "packages": [
    "jdk@21"
  ],
  "shell": {
    "init_hook": [
      "git config core.hooksPath .githooks || true",
      "git config --local credential.https://github.com.helper '!bash \"$(git rev-parse --show-toplevel)/scripts/git-credential-env\"' || true",
      "[ -f .env ] || echo 'Missing .env: copy .env.example to .env and put your SONAR_TOKEN in it.'"
    ],
    "scripts": {
      "build": "./mvnw -B verify",
      "test": "./mvnw -B test",
      "lint": "./mvnw -B checkstyle:check",
      "scan": "./scan.sh",
      "run": "DB_URL=jdbc:postgresql://localhost:5433/sonarcube DB_USER=sonarcube DB_PASSWORD=sonarcube-learn ./mvnw -B spring-boot:run",
      "startup": "docker compose --env-file .env -f startup/docker-compose.yml up -d --build",
      "startup-down": "docker compose --env-file .env -f startup/docker-compose.yml down",
      "db-up": "docker compose --env-file .env -f startup/docker-compose.yml up -d --wait db",
      "jenkins-logs": "docker compose --env-file .env -f startup/docker-compose.yml logs -f jenkins"
    }
  }
}
