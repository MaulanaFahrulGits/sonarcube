# Copy to .env (git-ignored) and fill in. Used by scan.sh, the commit hook and Jenkins (jenkins/docker-compose.yml).
# Quote values that contain spaces.

# SonarQube server and token. Token: avatar > My Account > Security > Generate Tokens (User Token).
SONAR_URL=https://sonarqube.example.com
SONAR_TOKEN=
# Project key (created by the first scan). Change it to reuse this setup for another project.
SONAR_PROJECT_KEY=my-project
# Optional display name in SonarQube (default: the key)
# SONAR_PROJECT_NAME="My Project"

# Jenkins container only (jenkins/docker-compose.yml)
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me
# Repo that holds the Jenkinsfile for the seeded job (default: this repo)
# PIPELINE_REPO_URL=https://github.com/MaulanaFahrulGits/sonarcube.git
# PIPELINE_BRANCH=main
# Optional Slack / Google Chat incoming webhook for failure messages
# CHAT_WEBHOOK_URL=
